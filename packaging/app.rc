// FlowSpace Windows resources: application icon + version info.
// NOTE: no manifest here on purpose. MinGW ld auto-links a default manifest object
// (gcc spec: %:if-exists(default-manifest.o%s)); embedding a second manifest via
// windres fails to link with ".rsrc merge failure: multiple non-default manifests".
// DPI awareness (PerMonitorV2) is set at runtime in src/app/main.cpp instead.
#include <windows.h>

// Application icon (generated by scripts/make-icon.ps1 into build/flowspace.ico).
1 ICON "..\\build\\flowspace.ico"

// Version info.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FlowSpace"
            VALUE "FileDescription",  "FlowSpace - per-monitor workspace manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "flowspace"
            VALUE "ProductName",      "FlowSpace"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

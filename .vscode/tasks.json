{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cppbuild",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++23",
                "-g",
                "-O0",
                "-static",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}\\src",
                "-I${workspaceFolder}\\external\\spdlog\\include",
                "${workspaceFolder}\\src\\app\\main.cpp",
                "${workspaceFolder}\\src\\core\\WorkspaceManager.cpp",
                "${workspaceFolder}\\src\\platform\\MonitorManager.cpp",
                "${workspaceFolder}\\src\\platform\\WindowmManager.cpp",
                "-o",
                "${workspaceFolder}\\build\\flowspace.exe",
                "-lshcore",
                "-ldwmapi"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build FlowSpace with the MinGW g++ toolchain"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\flowspace.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "build",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Build, then run FlowSpace (writes logs/ into the workspace root)"
        }
    ]
}
